{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GendByteMaster/EngSense/evals/schema.json",
  "title": "EngSense deterministic eval case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "mode",
    "task",
    "context",
    "evidence",
    "tempting_wrong_recommendation",
    "expected_decision_properties",
    "unacceptable_reasoning",
    "expected_quality_dimensions",
    "expected_authority",
    "verification_expectations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "focused",
        "refactoring",
        "architecture"
      ]
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "snippet": {
      "type": "string"
    },
    "tempting_wrong_recommendation": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "expected_decision_properties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "unacceptable_reasoning": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "expected_quality_dimensions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "expected_tradeoffs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expected_authority": {
      "enum": [
        "invariant",
        "rule",
        "strong_recommendation",
        "guidance",
        "heuristic",
        "note"
      ]
    },
    "verification_expectations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "revisit_when": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "specialist_boundary": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
